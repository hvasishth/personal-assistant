# Copy to .env (gitignored) or export in your shell:  cp .env.example .env
# The server loads this file at startup via Node's built-in --env-file.

# --- LLM provider abstraction ---
# Which provider implementation to use behind the LLMProvider interface.
#   fake      -> deterministic canned responses; no network, no key, free. Great for dev/evals.
#   anthropic -> real Anthropic API calls.
ADVISOR_PROVIDER=fake

# Model id passed to the provider (ignored by the fake provider).
ADVISOR_MODEL=claude-opus-5-5

# Only needed when ADVISOR_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Where on-disk scratch data lives (transcripts/memory before they move into Postgres).
ADVISOR_DATA_DIR=./data

# --- Database ---
# Postgres connection string. Matches the docker-compose.yml credentials.
# Adminer (web UI to poke at tables) runs at http://localhost:8081 when `make db-up`.
DATABASE_URL=postgres://advisor:advisor@localhost:5432/advisor

# --- Server ---
# Port the Express server listens on.
PORT=8787

# How chatty the logs are, least to most verbose:
#   silent | error | warn | info | debug | trace
# "trace" dumps every raw SSE block and every frame sent — handy for debugging
# the stream parser. Defaults to "info" when unset.
ADVISOR_LOG_LEVEL=info
