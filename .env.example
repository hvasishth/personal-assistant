# Copy to .env (gitignored) or export in your shell:  cp .env.example .env
# The server loads this file at startup via Node's built-in --env-file.

# --- LLM provider abstraction ---
# Which provider implementation to use behind the LLMProvider interface.
#   fake      -> deterministic canned responses; no network, no key, free. Great for dev/evals.
#   anthropic -> real Anthropic API calls.
ADVISOR_PROVIDER=fake

# Model id passed to the provider (ignored by the fake provider).
ADVISOR_MODEL=claude-opus-5-5

# Only needed when ADVISOR_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Where conversation transcripts / memory data live on disk (before we move to Postgres).
ADVISOR_DATA_DIR=./data

# --- Server ---
# Port the Express server listens on.
PORT=8787
